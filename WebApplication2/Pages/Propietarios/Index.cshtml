@page
@model WebApplication2.Pages.Propietarios.IndexModel
@{
    ViewData["Title"] = "Propietarios";
}

<!-- Encabezado de página -->
<div class="page-header">
    <h1><i class="bi bi-people-fill me-2"></i>Propietarios</h1>
    <a asp-page="Create" class="btn btn-vet-primary">
        <i class="bi bi-person-plus-fill me-1"></i>Nuevo Propietario
    </a>
</div>

<!-- Barra de búsqueda -->
<div class="card mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-sm-8 col-md-6">
                <label class="form-label mb-1">Buscar propietario</label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="busqueda" value="@Model.Busqueda"
                           class="form-control" placeholder="Nombre, apellido o correo…" />
                </div>
            </div>
            <div class="col-sm-4 col-md-3">
                <label class="form-label mb-1">Estado</label>
                <select name="filtroEstado" class="form-select">
                    <option value="">Todos</option>
                    <option value="Activo"   selected="@(Model.FiltroEstado == "Activo"   ? "selected" : null)">Activo</option>
                    <option value="Inactivo" selected="@(Model.FiltroEstado == "Inactivo" ? "selected" : null)">Inactivo</option>
                </select>
            </div>
            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-vet-primary">
                    <i class="bi bi-funnel me-1"></i>Filtrar
                </button>
                <a asp-page="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de resultados -->
<div class="card">
    <div class="card-header card-header-vet d-flex align-items-center justify-content-between">
        <span><i class="bi bi-list-ul me-2"></i>Lista de Propietarios</span>
        <span class="badge bg-white text-primary fw-semibold">@Model.Propietarios.Count registros</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Propietarios.Any())
        {
            <div class="table-responsive">
                <table class="table table-vet table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th><i class="bi bi-person me-1"></i>Nombre</th>
                            <th><i class="bi bi-telephone me-1"></i>Teléfono</th>
                            <th><i class="bi bi-envelope me-1"></i>Correo</th>
                            <th class="text-center"><i class="bi bi-heart me-1"></i>Mascotas</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Propietarios)
                        {
                            <tr>
                                <td class="text-muted small">@p.Id</td>
                                <td>
                                    <div class="fw-semibold">@p.NombreCompleto</div>
                                </td>
                                <td>@p.Telefono</td>
                                <td>
                                    <a href="mailto:@p.Correo" class="text-vet-blue text-decoration-none">
                                        @p.Correo
                                    </a>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary rounded-pill">
                                        @Model.ContarMascotas(p.Id)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge-estado @(p.Estado == EstadoGeneral.Activo ? "badge-activo" : "badge-inactivo")">
                                        @p.Estado
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-page="Details" asp-route-id="@p.Id"
                                           class="btn btn-sm btn-outline-info" title="Ver detalle">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-page="Edit" asp-route-id="@p.Id"
                                           class="btn btn-sm btn-outline-warning" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-page="Delete" asp-route-id="@p.Id"
                                           class="btn btn-sm btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">👥</div>
                <h5 class="text-muted">No se encontraron propietarios</h5>
                <p class="text-muted mb-3">Prueba cambiando los filtros o registra uno nuevo.</p>
                <a asp-page="Create" class="btn btn-vet-primary">
                    <i class="bi bi-person-plus me-1"></i>Agregar Propietario
                </a>
            </div>
        }
    </div>
</div>
