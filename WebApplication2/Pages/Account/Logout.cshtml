@page
@model WebApplication2.Pages.Account.LogoutModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Cerrando sesión";
}

<div class="auth-card text-center">
    <div class="auth-logo">
        <div class="logo-icon">🐾</div>
        <h1>El Arca de Moe</h1>
    </div>
    <div class="auth-divider"></div>
    <i class="bi bi-box-arrow-right" style="font-size:2.5rem;color:var(--phthalo);"></i>
    <h5 class="mt-2 fw-bold" style="color:var(--phthalo);">Sesión cerrada</h5>
    <p class="text-muted small">Has salido correctamente del sistema.</p>
    <a asp-page="Login" class="btn-auth d-inline-block mt-2" style="width:auto;padding:.5rem 1.5rem;">
        <i class="bi bi-box-arrow-in-right me-1"></i>Volver a ingresar
    </a>
</div>
