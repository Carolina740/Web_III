@page
@model WebApplication2.Pages.Account.RegistroModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Crear Cuenta";
}

<div class="auth-card" style="max-width:520px;">
    <div class="auth-logo">
        <div class="logo-icon">🐾</div>
        <h1>El Arca de Moe</h1>
        <p>Crear nueva cuenta de acceso</p>
    </div>
    <div class="auth-divider"></div>

    <h5 class="fw-bold mb-3" style="color:var(--phthalo);">
        <i class="bi bi-person-plus me-2"></i>Registro de Usuario
    </h5>

    <form method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 mb-3 small"></div>

        <div class="row g-3">
            <div class="col-sm-6">
                <label asp-for="Input.Nombre" class="form-label fw-semibold"></label>
                <input asp-for="Input.Nombre" class="form-control" placeholder="Ej: María" />
                <span asp-validation-for="Input.Nombre" class="text-danger small"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="Input.Apellido" class="form-label fw-semibold"></label>
                <input asp-for="Input.Apellido" class="form-control" placeholder="Ej: González" />
                <span asp-validation-for="Input.Apellido" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Input.Email" class="form-label fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-envelope text-muted"></i></span>
                    <input asp-for="Input.Email" class="form-control" placeholder="correo@ejemplo.com" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="Input.Password" class="form-label fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-lock text-muted"></i></span>
                    <input asp-for="Input.Password" class="form-control" placeholder="Contraseña" />
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="Input.ConfirmarPassword" class="form-label fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-lock-fill text-muted"></i></span>
                    <input asp-for="Input.ConfirmarPassword" class="form-control" placeholder="Repite la contraseña" />
                </div>
                <span asp-validation-for="Input.ConfirmarPassword" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-3 p-2 rounded-3 small text-muted" style="background:var(--vet-primary-light);">
            <i class="bi bi-info-circle me-1"></i>
            La contraseña debe tener mínimo 6 caracteres, incluir mayúsculas, minúsculas y un número.
        </div>

        <button type="submit" class="btn-auth mt-3">
            <i class="bi bi-person-check me-2"></i>Crear Cuenta
        </button>
    </form>

    <div class="auth-footer mt-3">
        ¿Ya tienes cuenta? <a asp-page="Login">Inicia sesión</a>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
