@page
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Acceso Denegado";
}

<div class="auth-card text-center">
    <div class="auth-logo">
        <div class="logo-icon">🔒</div>
        <h1>El Arca de Moe</h1>
    </div>
    <div class="auth-divider"></div>
    <h4 class="fw-bold" style="color:var(--vet-red);">Acceso Denegado</h4>
    <p class="text-muted">No tienes permisos para acceder a esta sección.</p>
    <div class="d-flex gap-2 justify-content-center mt-3">
        <a asp-page="/Index" class="btn-auth" style="width:auto;padding:.5rem 1.2rem;">
            <i class="bi bi-house me-1"></i>Ir al inicio
        </a>
        <a asp-page="Login" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión
        </a>
    </div>
</div>
