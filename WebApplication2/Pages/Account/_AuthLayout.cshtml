<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – El Arca de Moe</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, var(--phthalo) 0%, var(--atlantis) 50%, var(--periwinkle) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .auth-card {
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(14,21,94,.35);
            padding: 2.5rem;
            width: 100%;
            max-width: 440px;
        }
        .auth-logo {
            text-align: center;
            margin-bottom: 1.8rem;
        }
        .auth-logo .logo-icon {
            font-size: 3.5rem;
            filter: drop-shadow(0 4px 8px rgba(14,21,94,.3));
        }
        .auth-logo h1 {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--phthalo);
            margin: .4rem 0 .2rem;
        }
        .auth-logo p {
            color: var(--vet-text-muted);
            font-size: .85rem;
            margin: 0;
        }
        .auth-divider {
            height: 3px;
            background: linear-gradient(90deg, var(--phthalo), var(--periwinkle), var(--phlox));
            border-radius: 2px;
            margin-bottom: 1.5rem;
        }
        .btn-auth {
            background: linear-gradient(135deg, var(--phthalo) 0%, var(--atlantis) 100%);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: .65rem 1rem;
            font-weight: 700;
            font-size: 1rem;
            width: 100%;
            transition: opacity .2s, transform .15s;
        }
        .btn-auth:hover {
            opacity: .88;
            transform: translateY(-1px);
            color: #fff;
        }
        .form-control:focus {
            border-color: var(--periwinkle);
            box-shadow: 0 0 0 .2rem rgba(121,151,230,.28);
        }
        .auth-footer {
            text-align: center;
            margin-top: 1.2rem;
            font-size: .88rem;
            color: var(--vet-text-muted);
        }
        .auth-footer a {
            color: var(--atlantis);
            font-weight: 600;
            text-decoration: none;
        }
        .auth-footer a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    @RenderBody()
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
