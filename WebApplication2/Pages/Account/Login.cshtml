@page
@model WebApplication2.Pages.Account.LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="auth-card">
    <div class="auth-logo">
        <div class="logo-icon">🐾</div>
        <h1>El Arca de Moe</h1>
        <p>Clínica Veterinaria – Sistema de Gestión</p>
    </div>
    <div class="auth-divider"></div>

    <h5 class="fw-bold mb-3" style="color:var(--phthalo);">
        <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión
    </h5>

    <form method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 mb-3 small"></div>

        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label fw-semibold"></label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-envelope text-muted"></i></span>
                <input asp-for="Input.Email" class="form-control"
                       placeholder="correo@ejemplo.com" autocomplete="username" />
            </div>
            <span asp-validation-for="Input.Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label fw-semibold"></label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-lock text-muted"></i></span>
                <input asp-for="Input.Password" class="form-control"
                       placeholder="Contraseña" autocomplete="current-password" />
            </div>
            <span asp-validation-for="Input.Password" class="text-danger small"></span>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="Input.RecuerdaMe" class="form-check-input" type="checkbox" />
            <label asp-for="Input.RecuerdaMe" class="form-check-label text-muted small"></label>
        </div>

        <button type="submit" class="btn-auth">
            <i class="bi bi-box-arrow-in-right me-2"></i>Ingresar
        </button>
    </form>

    <div class="auth-footer mt-3">
        ¿No tienes cuenta? <a asp-page="Registro">Regístrate aquí</a>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
