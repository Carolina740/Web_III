@page
@model WebApplication2.Pages.Veterinarios.IndexModel
@{
    ViewData["Title"] = "Veterinarios";
}

<div class="page-header">
    <h1><i class="bi bi-person-badge-fill me-2"></i>Veterinarios</h1>
    <a asp-page="Create" class="btn btn-vet-primary">
        <i class="bi bi-person-plus-fill me-1"></i>Nuevo Veterinario
    </a>
</div>

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-sm-6 col-md-5">
                <label class="form-label mb-1">Buscar</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="busqueda" value="@Model.Busqueda"
                           class="form-control" placeholder="Nombre, apellido o especialidad…" />
                </div>
            </div>
            <div class="col-sm-4 col-md-3">
                <label class="form-label mb-1">Estado</label>
                <select name="filtroEstado" class="form-select">
                    <option value="">Todos</option>
                    <option value="Activo"   selected="@(Model.FiltroEstado == "Activo"   ? "selected" : null)">Activo</option>
                    <option value="Inactivo" selected="@(Model.FiltroEstado == "Inactivo" ? "selected" : null)">Inactivo</option>
                </select>
            </div>
            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-vet-primary">
                    <i class="bi bi-funnel me-1"></i>Filtrar
                </button>
                <a asp-page="Index" class="btn btn-outline-secondary" title="Limpiar filtros">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla -->
<div class="card">
    <div class="card-header card-header-vet d-flex align-items-center justify-content-between">
        <span><i class="bi bi-list-ul me-2"></i>Personal Médico</span>
        <span class="badge bg-white text-success fw-semibold">@Model.Veterinarios.Count registros</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Veterinarios.Any())
        {
            <div class="table-responsive">
                <table class="table table-vet table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th><i class="bi bi-person-badge me-1"></i>Nombre</th>
                            <th><i class="bi bi-award me-1"></i>Especialidad</th>
                            <th><i class="bi bi-telephone me-1"></i>Teléfono</th>
                            <th class="text-center"><i class="bi bi-calendar2 me-1"></i>Citas Activas</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.Veterinarios)
                        {
                            <tr>
                                <td class="text-muted small">@v.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="vet-avatar">
                                            @v.Nombre[0]@v.Apellido[0]
                                        </div>
                                        <div>
                                            <div class="fw-semibold">@v.NombreCompleto</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-vet-light text-vet-green border border-success-subtle">
                                        <i class="bi bi-award me-1"></i>@v.Especialidad
                                    </span>
                                </td>
                                <td>@v.Telefono</td>
                                <td class="text-center">
                                    <span class="badge bg-secondary rounded-pill">
                                        @Model.ContarCitasPendientes(v.Id)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge-estado @(v.Estado == EstadoGeneral.Activo ? "badge-activo" : "badge-inactivo")">
                                        @v.Estado
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-page="Details" asp-route-id="@v.Id"
                                           class="btn btn-sm btn-outline-info" title="Ver detalle">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-page="Edit" asp-route-id="@v.Id"
                                           class="btn btn-sm btn-outline-warning" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-page="Delete" asp-route-id="@v.Id"
                                           class="btn btn-sm btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">🩺</div>
                <h5 class="text-muted">No se encontraron veterinarios</h5>
                <p class="text-muted mb-3">Prueba cambiando los filtros o registra uno nuevo.</p>
                <a asp-page="Create" class="btn btn-vet-primary">
                    <i class="bi bi-person-plus me-1"></i>Agregar Veterinario
                </a>
            </div>
        }
    </div>
</div>

<style>
    .vet-avatar {
        width: 36px; height: 36px; border-radius: 50%;
        background: linear-gradient(135deg, var(--vet-green), var(--vet-teal));
        color: #fff; font-weight: 700; font-size: .8rem;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0; text-transform: uppercase;
    }
</style>
