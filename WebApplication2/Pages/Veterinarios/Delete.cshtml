@page "{id:int}"
@model WebApplication2.Pages.Veterinarios.DeleteModel
@{
    ViewData["Title"] = "Eliminar Veterinario";
}

<nav aria-label="breadcrumb" class="breadcrumb-vet">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-page="/Index"><i class="bi bi-house"></i></a></li>
        <li class="breadcrumb-item"><a asp-page="Index">Veterinarios</a></li>
        <li class="breadcrumb-item active">Eliminar</li>
    </ol>
</nav>

<div class="row justify-content-center mt-2">
    <div class="col-lg-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Eliminación
            </div>
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div style="font-size:3.5rem;">⚠️</div>
                    <h5 class="mt-2">¿Eliminar a <strong>@Model.Veterinario?.NombreCompleto</strong>?</h5>
                    <p class="text-muted">Esta acción no se puede deshacer.</p>
                </div>

                @if (Model.TieneCitas)
                {
                    <div class="alert alert-warning d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-circle-fill fs-5"></i>
                        <div>
                            Este veterinario tiene <strong>@Model.CantidadCitas cita(s)</strong> asignada(s).
                            Elimine o reasigne las citas antes de eliminar al veterinario.
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <a asp-page="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Volver
                        </a>
                    </div>
                }
                else
                {
                    <dl class="row mb-3">
                        <dt class="col-5 text-muted">Nombre completo</dt>
                        <dd class="col-7">@Model.Veterinario?.NombreCompleto</dd>
                        <dt class="col-5 text-muted">Especialidad</dt>
                        <dd class="col-7">@Model.Veterinario?.Especialidad</dd>
                        <dt class="col-5 text-muted">Teléfono</dt>
                        <dd class="col-7">@Model.Veterinario?.Telefono</dd>
                        <dt class="col-5 text-muted">Estado</dt>
                        <dd class="col-7">@Model.Veterinario?.Estado</dd>
                    </dl>

                    <form method="post">
                        @Html.AntiForgeryToken()
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-page="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash-fill me-1"></i>Sí, eliminar
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
