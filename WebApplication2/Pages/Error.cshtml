@page
@model WebApplication2.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div style="font-size:5rem;">🐾</div>
        <h1 class="display-4 fw-bold text-vet-blue mt-2">¡Oops!</h1>
        <h4 class="text-muted mb-3">Algo salió mal al procesar tu solicitud.</h4>

        @if (Model.ShowRequestId)
        {
            <div class="alert alert-vet-danger mb-3">
                <strong>ID de solicitud:</strong> <code>@Model.RequestId</code>
            </div>
        }

        <p class="text-muted mb-4">
            Por favor intenta de nuevo. Si el problema persiste,
            contacta al administrador del sistema.
        </p>

        <div class="d-flex gap-2 justify-content-center">
            <a asp-page="/Index" class="btn btn-vet-primary">
                <i class="bi bi-house me-1"></i>Volver al Dashboard
            </a>
            <button onclick="history.back()" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Página anterior
            </button>
        </div>
    </div>
</div>
