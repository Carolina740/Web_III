@page "{id:int}"
@model WebApplication2.Pages.Citas.DetailsModel
@{
    ViewData["Title"] = "Detalle de la Cita";
    var c = Model.Cita!;
    var badgeClass = c.Estado switch
    {
        EstadoCita.Pendiente  => "badge-pendiente",
        EstadoCita.Completada => "badge-completada",
        _                     => "badge-cancelada"
    };
    var estadoIcon = c.Estado switch
    {
        EstadoCita.Pendiente  => "bi-hourglass-split",
        EstadoCita.Completada => "bi-check-circle-fill",
        _                     => "bi-x-circle-fill"
    };
}

<nav aria-label="breadcrumb" class="breadcrumb-vet">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-page="/Index"><i class="bi bi-house"></i></a></li>
        <li class="breadcrumb-item"><a asp-page="Index">Citas</a></li>
        <li class="breadcrumb-item active">Cita #@c.Id</li>
    </ol>
</nav>

<div class="page-header">
    <h1>
        <i class="bi bi-clipboard2-pulse me-2"></i>Cita #@c.Id
        <span class="badge-estado @badgeClass ms-2" style="font-size:.8rem;">
            <i class="bi @estadoIcon me-1"></i>@c.Estado
        </span>
    </h1>
    <div class="d-flex gap-2">
        <a asp-page="Edit" asp-route-id="@c.Id" class="btn btn-outline-warning">
            <i class="bi bi-pencil me-1"></i>Editar
        </a>
        <a asp-page="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Información general -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header card-header-vet">
                <i class="bi bi-info-circle me-2"></i>Información de la Cita
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5 text-muted small">Fecha y Hora</dt>
                    <dd class="col-7 fw-semibold">@c.FechaHora.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-5 text-muted small">Mascota</dt>
                    <dd class="col-7">
                        <a asp-page="/Mascotas/Details" asp-route-id="@c.MascotaId"
                           class="text-vet-blue text-decoration-none fw-semibold">
                            <i class="bi bi-heart me-1"></i>@c.Mascota?.Nombre
                        </a>
                        <div class="text-muted small">@c.Mascota?.Especie – @c.Mascota?.Raza</div>
                    </dd>

                    <dt class="col-5 text-muted small">Propietario</dt>
                    <dd class="col-7">
                        <a asp-page="/Propietarios/Details" asp-route-id="@c.Mascota?.PropietarioId"
                           class="text-vet-blue text-decoration-none">
                            <i class="bi bi-person me-1"></i>@c.Mascota?.Propietario?.NombreCompleto
                        </a>
                    </dd>

                    <dt class="col-5 text-muted small">Veterinario</dt>
                    <dd class="col-7">
                        <a asp-page="/Veterinarios/Details" asp-route-id="@c.VeterinarioId"
                           class="text-vet-blue text-decoration-none">
                            <i class="bi bi-person-badge me-1"></i>@c.Veterinario?.NombreCompleto
                        </a>
                        <div class="text-muted small">@c.Veterinario?.Especialidad</div>
                    </dd>

                    <dt class="col-5 text-muted small">Estado</dt>
                    <dd class="col-7">
                        <span class="badge-estado @badgeClass">@c.Estado</span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Motivo y diagnóstico -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header card-header-vet">
                <i class="bi bi-clipboard2-pulse me-2"></i>Motivo y Diagnóstico
            </div>
            <div class="card-body d-flex flex-column gap-3">
                <!-- Motivo -->
                <div>
                    <p class="text-muted small fw-bold mb-1 text-uppercase">
                        <i class="bi bi-chat-left-text me-1"></i>Motivo de la Consulta
                    </p>
                    <div class="p-3 rounded-3 bg-vet-light">
                        @c.Motivo
                    </div>
                </div>

                <!-- Diagnóstico -->
                <div>
                    <p class="text-muted small fw-bold mb-1 text-uppercase">
                        <i class="bi bi-prescription me-1"></i>Diagnóstico
                    </p>
                    @if (!string.IsNullOrWhiteSpace(c.Diagnostico))
                    {
                        <div class="p-3 rounded-3" style="background: var(--vet-cyan-light); border-left: 4px solid var(--vet-cyan);">
                            @c.Diagnostico
                        </div>
                    }
                    else
                    {
                        <div class="p-3 rounded-3 bg-light text-muted fst-italic d-flex align-items-center gap-2">
                            <i class="bi bi-clock-history"></i>
                            Pendiente de diagnóstico
                            @if (c.Estado == EstadoCita.Pendiente)
                            {
                                <a asp-page="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary ms-auto">
                                    <i class="bi bi-pencil me-1"></i>Agregar
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Acciones rápidas de estado -->
@if (c.Estado == EstadoCita.Pendiente)
{
    <div class="card mt-4 border-0" style="background: var(--vet-blue-light);">
        <div class="card-body py-3 d-flex align-items-center gap-3 flex-wrap">
            <span class="fw-semibold text-vet-blue">
                <i class="bi bi-lightning-charge me-1"></i>Acciones rápidas:
            </span>
            <form method="post" asp-page-handler="CambiarEstado">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id"     value="@c.Id" />
                <input type="hidden" name="estado" value="Completada" />
                <button type="submit" class="btn btn-sm btn-success">
                    <i class="bi bi-check-circle me-1"></i>Marcar como Completada
                </button>
            </form>
            <form method="post" asp-page-handler="CambiarEstado">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id"     value="@c.Id" />
                <input type="hidden" name="estado" value="Cancelada" />
                <button type="submit" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-x-circle me-1"></i>Cancelar Cita
                </button>
            </form>
        </div>
    </div>
}
