@page "{id:int}"
@model WebApplication2.Pages.Mascotas.DetailsModel
@{
    ViewData["Title"] = "Detalle de la Mascota";
    var m = Model.Mascota!;
}

<nav aria-label="breadcrumb" class="breadcrumb-vet">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-page="/Index"><i class="bi bi-house"></i></a></li>
        <li class="breadcrumb-item"><a asp-page="Index">Mascotas</a></li>
        <li class="breadcrumb-item active">@m.Nombre</li>
    </ol>
</nav>

<div class="page-header">
    <h1>
        @(m.Especie.ToLower() == "perro" ? "🐶" : m.Especie.ToLower() == "gato" ? "🐱" : m.Especie.ToLower() == "ave" ? "🐦" : "🐾")
        @m.Nombre
    </h1>
    <div class="d-flex gap-2">
        <a asp-page="Edit" asp-route-id="@m.Id" class="btn btn-outline-warning">
            <i class="bi bi-pencil me-1"></i>Editar
        </a>
        <a asp-page="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Ficha de la mascota -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header card-header-vet">
                <i class="bi bi-clipboard-heart me-2"></i>Ficha Médica
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5 text-muted small">Nombre</dt>
                    <dd class="col-7 fw-semibold">@m.Nombre</dd>

                    <dt class="col-5 text-muted small">Especie</dt>
                    <dd class="col-7">@m.Especie</dd>

                    <dt class="col-5 text-muted small">Raza</dt>
                    <dd class="col-7">@m.Raza</dd>

                    <dt class="col-5 text-muted small">Color</dt>
                    <dd class="col-7">@m.Color</dd>

                    <dt class="col-5 text-muted small">Fecha de Nacimiento</dt>
                    <dd class="col-7">@m.FechaNacimiento.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-5 text-muted small">Edad</dt>
                    <dd class="col-7">
                        <span class="badge bg-info text-white">@m.Edad años</span>
                    </dd>

                    <dt class="col-5 text-muted small">Estado</dt>
                    <dd class="col-7">
                        <span class="badge-estado @(m.Estado == EstadoGeneral.Activo ? "badge-activo" : "badge-inactivo")">
                            @m.Estado
                        </span>
                    </dd>

                    <dt class="col-5 text-muted small">Propietario</dt>
                    <dd class="col-7">
                        <a asp-page="/Propietarios/Details"
                           asp-route-id="@m.PropietarioId"
                           class="text-vet-green text-decoration-none fw-semibold">
                            <i class="bi bi-person me-1"></i>@m.Propietario?.NombreCompleto
                        </a>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Historial de citas -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header card-header-vet d-flex justify-content-between align-items-center">
                <span><i class="bi bi-calendar2-check me-2"></i>Historial de Citas</span>
                <a asp-page="/Citas/Create" asp-route-mascotaId="@m.Id"
                   class="btn btn-sm btn-light text-success fw-semibold">
                    <i class="bi bi-plus me-1"></i>Nueva Cita
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.Citas.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-vet table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Veterinario</th>
                                    <th>Motivo</th>
                                    <th class="text-center">Estado</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.Citas)
                                {
                                    <tr>
                                        <td class="small">@c.FechaHoraFormateada</td>
                                        <td class="small">@c.Veterinario?.Apellido</td>
                                        <td class="small">@c.Motivo</td>
                                        <td class="text-center">
                                            <span class="badge-estado
                                                @(c.Estado == EstadoCita.Pendiente   ? "badge-pendiente"  :
                                                  c.Estado == EstadoCita.Completada  ? "badge-completada" :
                                                                                       "badge-cancelada")">
                                                @c.Estado
                                            </span>
                                        </td>
                                        <td>
                                            <a asp-page="/Citas/Details" asp-route-id="@c.Id"
                                               class="btn btn-sm btn-outline-info">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state py-4">
                        <div class="empty-icon">📋</div>
                        <p class="text-muted mb-2">No hay citas registradas para esta mascota.</p>
                        <a asp-page="/Citas/Create" asp-route-mascotaId="@m.Id"
                           class="btn btn-sm btn-vet-primary">
                            <i class="bi bi-plus me-1"></i>Agendar cita
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
