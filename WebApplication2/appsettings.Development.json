{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  /*
   * En DESARROLLO se usa SQLite por defecto:
   * no requiere instalar ningún motor de BD.
   * El archivo VeterinariaArcaMoe.db se crea automáticamente.
   *
   * Para usar SQL Server en desarrollo, cambia los dos valores
   * y actualiza la cadena de conexión en appsettings.json.
   */
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=VeterinariaArcaMoe.db"
  },
  "DatabaseProvider": "Sqlite"
}
