@model WebApplication3.Models.Libro
@{
    ViewData["Title"] = "Nuevo libro";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header" style="background-color:#1a3a5c; color:white;">
                <h5 class="mb-0">Registrar nuevo libro</h5>
            </div>
            <div class="card-body">
                <form asp-action="Crear" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label"></label>
                        <input asp-for="Titulo" class="form-control" />
                        <span asp-validation-for="Titulo" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Autor" class="form-label"></label>
                        <input asp-for="Autor" class="form-control" />
                        <span asp-validation-for="Autor" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ISBN" class="form-label"></label>
                            <input asp-for="ISBN" class="form-control" />
                            <span asp-validation-for="ISBN" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Categoria" class="form-label"></label>
                            <input asp-for="Categoria" class="form-control" />
                            <span asp-validation-for="Categoria" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CantidadDisponible" class="form-label"></label>
                            <input asp-for="CantidadDisponible" class="form-control" type="number" min="0" />
                            <span asp-validation-for="CantidadDisponible" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="AnioPublicacion" class="form-label"></label>
                            <input asp-for="AnioPublicacion" class="form-control" type="number" />
                            <span asp-validation-for="AnioPublicacion" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
