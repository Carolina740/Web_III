@model IEnumerable<WebApplication3.Models.Libro>
@{
    ViewData["Title"] = "Libros";
    var rolActual = Context.Session.GetString("UsuarioRol");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Catálogo de libros</h4>
    <a asp-action="Crear" class="btn btn-primary btn-sm">+ Nuevo libro</a>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2">
        @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-hover table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Título</th>
                <th>Autor</th>
                <th>ISBN</th>
                <th>Categoría</th>
                <th>Año</th>
                <th>Disponibles</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var libro in Model)
            {
                <tr>
                    <td>@libro.Titulo</td>
                    <td>@libro.Autor</td>
                    <td>@libro.ISBN</td>
                    <td>@libro.Categoria</td>
                    <td>@libro.AnioPublicacion</td>
                    <td>
                        <span class="badge @(libro.CantidadDisponible > 0 ? "bg-success" : "bg-danger")">
                            @libro.CantidadDisponible
                        </span>
                    </td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@libro.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                        @if (rolActual == "Administrador")
                        {
                            <a asp-action="Eliminar" asp-route-id="@libro.Id" class="btn btn-sm btn-outline-danger ms-1">Eliminar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
