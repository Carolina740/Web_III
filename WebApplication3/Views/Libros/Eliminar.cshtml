@model WebApplication3.Models.Libro
@{
    ViewData["Title"] = "Eliminar libro";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">Confirmar eliminación</h5>
            </div>
            <div class="card-body">
                <p>¿Está seguro que desea eliminar el siguiente libro?</p>
                <dl class="row">
                    <dt class="col-sm-4">Título</dt>
                    <dd class="col-sm-8">@Model.Titulo</dd>
                    <dt class="col-sm-4">Autor</dt>
                    <dd class="col-sm-8">@Model.Autor</dd>
                    <dt class="col-sm-4">ISBN</dt>
                    <dd class="col-sm-8">@Model.ISBN</dd>
                </dl>
                <form asp-action="Eliminar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
