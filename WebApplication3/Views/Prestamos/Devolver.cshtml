@model WebApplication3.Models.Prestamo
@{
    ViewData["Title"] = "Registrar devolución";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header" style="background-color:#1a3a5c; color:white;">
                <h5 class="mb-0">Confirmar devolución</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-5">Usuario</dt>
                    <dd class="col-sm-7">@Model.Usuario?.Nombre</dd>
                    <dt class="col-sm-5">Libro</dt>
                    <dd class="col-sm-7">@Model.Libro?.Titulo</dd>
                    <dt class="col-sm-5">Fecha de préstamo</dt>
                    <dd class="col-sm-7">@Model.FechaPrestamo.ToString("dd/MM/yyyy")</dd>
                    <dt class="col-sm-5">Fecha límite</dt>
                    <dd class="col-sm-7">@Model.FechaLimite.ToString("dd/MM/yyyy")</dd>
                </dl>
                <form asp-action="Devolver" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Confirmar devolución</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
