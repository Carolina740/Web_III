@model IEnumerable<WebApplication3.Models.Usuario>
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Usuarios del sistema</h4>
    <a asp-action="Crear" class="btn btn-primary btn-sm">+ Nuevo usuario</a>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2">
        @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-hover table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Nombre</td>
                    <td>@u.Correo</td>
                    <td>
                        <span class="badge @(u.Rol == "Administrador" ? "bg-danger" : u.Rol == "Bibliotecario" ? "bg-primary" : "bg-secondary")">
                            @u.Rol
                        </span>
                    </td>
                    <td>
                        <span class="badge @(u.Activo ? "bg-success" : "bg-secondary")">
                            @(u.Activo ? "Activo" : "Inactivo")
                        </span>
                    </td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@u.Id" class="btn btn-sm btn-outline-danger ms-1">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
